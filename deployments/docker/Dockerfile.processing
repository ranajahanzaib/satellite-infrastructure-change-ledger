# Python Geospatial & ML Processing Worker
FROM python:3.10-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

COPY services/processing/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir numpy scipy shapely pydantic requests pillow

COPY services/processing/ /app/services/processing/
COPY data/ /app/data/

ENV PYTHONPATH=/app/services/processing
ENV PROCESSING_PORT=8081

EXPOSE 8081
CMD ["python", "services/processing/src/workers/server.py"]

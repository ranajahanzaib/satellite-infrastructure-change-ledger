# Environment Variables for Satellite Infrastructure Change Ledger

# Application Ports
PORT=8080
PROCESSING_PORT=8081
WEB_PORT=3000

# Go API Configuration
APP_ENV=development
JWT_SECRET=supersecret_jwt_change_ledger_signing_key_32chars
PY_WORKER_URL=http://localhost:8081

# PostgreSQL & PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=satledger
DB_PASSWORD=satledger_secret
DB_NAME=satledger_db
DATABASE_URL=postgres://satledger:satledger_secret@localhost:5432/satledger_db?sslmode=disable

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=satledger-imagery

# STAC Endpoints
PLANETARY_COMPUTER_STAC=https://planetarycomputer.microsoft.com/api/stac/v1
EARTH_SEARCH_STAC=https://earth-search.aws.element84.com/v1

# Foundation Models
CLAY_MODEL_PATH=data/models/clay_v1.5.pt
PRITHVI_MODEL_PATH=data/models/prithvi_eo_2.pt
USE_CPU_FALLBACK=true
